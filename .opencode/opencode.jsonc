{
  "$schema": "https://opencode.ai/config.json",
  "skills": ["./.agents/skills"],
  // Модель субагента general (built-in):
  //   локальная: freetoken/Qwen3.6-35B-A3B-NVFP4
  //   облачная:  neuraldeep/qwen3.6-35b-a3b
  // Переключение — заменить "model" ниже и перезапустить сессию.
  // Явный параметр model в вызове subagent имеет приоритет.
  // Лимит одновременных субагентов (AGENTS.md §5.4, исполняется агентом):
  //   локальная модель — не более 1 параллельного субагента;
  //   облачная модель  — не более 2 параллельных субагентов.
  "agents": {
    "general": {
      "description": "General-purpose agent — research, multi-step work, subagent orchestration",
      "mode": "subagent",
      "model": "freetoken/Qwen3.6-35B-A3B-NVFP4"
    }
  }
}
