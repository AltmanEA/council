{
  "$schema": "https://opencode.ai/config.json",
  "skills": ["./.agents/skills"],
  "agent": {
    "subtask": {
      "description": "Исполнитель отдельных подзадач (механическая работа: записи, правки, проверки по явной инструкции). Использовать для делегирования отдельных подзадач.",
      "mode": "subagent",
      // Переключение модели субагента: заменить значение "model" ниже на
      // одно из двух (перезапуск сессии после правки):
      //   локальная: freetoken/Qwen3.6-35B-A3B-NVFP4
      //   облачная:  neuraldeep/qwen3.6-35b-a3b
      // Лимит одновременных субагентов (правило AGENTS.md §5.4, исполняется
      // агентом — в конфиге механического limit нет):
      //   локальная модель — не более 1 параллельного субагента;
      //   облачная модель  — не более 2 параллельных субагентов.
      "model": "freetoken/Qwen3.6-35B-A3B-NVFP4"
    }
  }
}
