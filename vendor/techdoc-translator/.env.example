# techdoc-translator environment configuration.
# Copy this file to .env and fill in the values.
# .env is loaded automatically if present in the same directory.
#
# TRANSLATE_BACKEND: "local" (default) or "cloud" (requires TRANSLATE_API_KEY + --allow-cloud)
TRANSLATE_BACKEND=local
#
# Local backend settings. Auto-detected from TRANSLATE_API_BASE:
#   ends with /v1  -> OpenAI-compatible server (/v1/chat/completions)
#   otherwise      -> Ollama-compatible server (/api/generate)
TRANSLATE_API_BASE=http://127.0.0.1:8000/v1
#
# Cloud backend settings (required when TRANSLATE_BACKEND=cloud):
# TRANSLATE_API_BASE=<YOUR-API-BASE>
# TRANSLATE_API_KEY=<YOUR-KEY>
#
# Model selection:
TRANSLATE_MODEL=local-model
#
# Generation parameters:
TRANSLATE_TEMP=0.2
TRANSLATE_TOP_P=0.95
#
# Glossary hint style: plain | verbose | strict
TRANSLATE_HINT_STYLE=plain
#
# System prompt variant: "codeguard" (default: none, uses basic prompt)
# TRANSLATE_PROMPT=codeguard
#
# Extra kwargs for chat requests (JSON string):
TRANSLATE_CHAT_KWARGS='{"enable_thinking":false}'
#
# Translate metadata lines instead of skipping them:
# TRANSLATE_METADATA=1
#
# Merge all prose into one block for translation:
# TRANSLATE_FORCE_SECTION=1
#
# Curl timeout in seconds:
REQUEST_TIMEOUT=120
#
# Retries per chunk:
MAX_RETRIES=2
#
# Global deadline for all requests (0 = off):
TOTAL_DEADLINE_SECONDS=0
#
# JSONL run-log path (optional):
# TRANSLATE_RUN_LOG=/path/to/run-log.jsonl
#
# Mock responses directory (for testing, no network):
# TRANSLATE_MOCK_DIR=/path/to/mock-dir
