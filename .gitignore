# Session workspace files — local only, not versioned (AGENTS.md §2.4),
# EXCEPT decision artifacts: consensus-doc.md and task-brief.md are tracked
# (OP-3 auditability: commit messages reference them; consensus
# sess-branch-version-strategy, 2026-11-23, operator decision №2).
sessions/*
!sessions/*/
sessions/*/*
!sessions/*/consensus-doc.md
!sessions/*/task-brief.md

# Generated engine trees for v2 development sessions — produced by
# tools/gen_engine.sh, never committed (consensus sess-branch-version-strategy).
.engine/

# Distribution build artifacts — generated by dist/build.sh
dist/out/

# Python bytecode caches for tools/ and tests/
__pycache__/
*.pyc

# Translator vendor secrets — always untracked (INTEGRATION.md §4)
vendor/techdoc-translator/.env

# documenter/ is intentionally NOT ignored: it holds git-tracked translation
# provenance artifacts (documenter/artifacts/; ADR-014). The v0 audit registry
# and intent state were deleted in the 2026-11-19 reconstruction.
